# このファイルを .env にコピーします。既存の .env がある場合は必要な行だけ追記します。
# .env を共有したり、Git・SVN・公開リポジトリへ登録したりしないでください。
# NovelAIを使う場合だけ、永続的APIトークンを指定します。
NOVELAI_API_KEY=

# ローカル制作AI（画面の「Strata」選択時）。未設定・空欄なら下記の既定値です。
# /v1だけではなく、/chat/completionsまで指定します。変更後はStudioを再起動します。
# OSの同名環境変数が優先。URLへの認証情報・クエリの埋込みには対応しません。
LOCAL_AI_URL=http://127.0.0.1:8080/v1/chat/completions
LOCAL_AI_MODEL=qwen3.8-flash-next-iq2_xs
